<Window x:Class="ConvertirJsonClaseC_.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JSON ↔ C# (POE)" Height="760" Width="1040">
    <Grid Margin="12">
        <TabControl>
            <!-- ======================= TAB 1: JSON -> C# ======================= -->
            <TabItem Header="JSON → C#">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Namespace:" VerticalAlignment="Center"/>
                        <TextBox x:Name="NamespaceBox"
                                 Width="320"
                                 Margin="8,0,16,0"
                                 Text="CPM.X.X"
                                 ToolTip="Espacio de nombres de la clase. Aparece en la parte superior del archivo y agrupa lógicamente las clases (ej.: MiEmpresa.Proyecto.Módulo)"/>

                        <TextBlock Text="Class name:" VerticalAlignment="Center"/>
                        <TextBox x:Name="ClassNameBox"
                                 Width="220"
                                 Margin="8,0,16,0"
                                 Text="Prueba"
                                 ToolTip="Nombre con el que se creará la clase raíz a partir del JSON (usa PascalCase, ej.: Cliente, OrdenDeCompra)"/>

                        <TextBlock Text="Autor:" VerticalAlignment="Center"/>
                        <TextBox x:Name="AuthorNameBox"
                                 Width="200"
                                 Margin="8,0,8,0"
                                 Text="NombreUsuario"
                                 ToolTip="Creador de la clase (se mostrará en los comentarios XML). Ej.: Juan Pérez"/>

                        <TextBlock Text="ID:" VerticalAlignment="Center"/>
                        <TextBox x:Name="AuthorIdBox"
                                 Width="130"
                                 Margin="8,0,0,0"
                                 Text="IDCPM"
                                 ToolTip="Identificador del colaborador (legajo/employee ID). Se agrega junto al nombre del autor, ej.: BANR25734"/>
                    </StackPanel>

                    <!-- Row 1 -->
                    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,8">
                        <CheckBox x:Name="UseAiDescriptions" Content="Generar descripciones con IA (POE)" IsChecked="True"/>
                        <TextBlock x:Name="SelectedFileLabel" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>

                    <!-- Row 2 -->
                    <GroupBox Header="JSON de entrada" Grid.Row="2" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,6">
                                <Button x:Name="BtnImport" Content="Importar JSON…" Width="150" Margin="0,0,8,0" Click="BtnImport_Click"/>
                                <Button x:Name="BtnClear" Content="Limpiar" Width="110" Click="BtnClear_Click"/>
                            </StackPanel>

                            <!-- Altura fija -->
                            <TextBox x:Name="JsonInput"
                                     Grid.Row="1"
                                     Height="260"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     TextChanged="JsonInput_TextChanged"
                                     ToolTip="Pega aquí un JSON de ejemplo que represente el objeto raíz. Debe comenzar con { ... }"/>
                        </Grid>
                    </GroupBox>

                    <!-- Row 3 -->
                    <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,0,0,8" HorizontalAlignment="Left">
                        <Button x:Name="BtnGenerate" Content="Generar clase(s)" Width="150" Click="BtnGenerate_Click"/>
                        <TextBlock x:Name="StatusText" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Row 4 -->
                    <GroupBox Header="Código generado" Grid.Row="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Margin="4,4,0,0" Foreground="Gray"/>
                                <Button x:Name="BtnCopy"
                                        Grid.Column="1"
                                        Content="Copiar"
                                        Width="110"
                                        Height="28"
                                        Click="BtnCopy_Click"/>
                            </Grid>

                            <!-- Altura fija -->
                            <TextBox x:Name="OutputCode"
                                     Grid.Row="1"
                                     Height="260"
                                     AcceptsReturn="True"
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     IsReadOnly="True"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ======================= TAB 2: C# -> JSON ======================= -->
            <TabItem Header="C# → JSON">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Encabezado -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Nombre clase raíz:" VerticalAlignment="Center"/>
                        <TextBox x:Name="RootClassBox"
                                 Width="260"
                                 Margin="8,0,16,0"
                                 Text="NombreEntidad"
                                 ToolTip="Nombre de la clase que se usará como objeto raíz al generar el JSON de ejemplo. Debe coincidir exactamente con una clase pública detectada en el código. Si lo dejas vacío se usará “Root”."/>

                        <CheckBox x:Name="PrettyJson" Content="JSON con sangría" IsChecked="True"/>
                        <TextBlock x:Name="SelectedCsLabel" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>

                    <!-- Entrada C# -->
                    <GroupBox Header="Código C# de entrada" Grid.Row="1" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,6">
                                <Button x:Name="BtnImportCs" Content="Importar .cs…" Width="150" Margin="0,0,8,0" Click="BtnImportCs_Click"/>
                                <Button x:Name="BtnClearCs" Content="Limpiar" Width="110" Click="BtnClearCs_Click"/>
                            </StackPanel>

                            <!-- Altura fija -->
                            <TextBox x:Name="CsInput"
                                     Grid.Row="1"
                                     Height="260"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     ToolTip="Pega aquí el código C# con clases públicas. El generador detectará propiedades públicas y producirá un JSON de ejemplo."/>
                        </Grid>
                    </GroupBox>

                    <!-- Botón generar -->
                    <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,8" HorizontalAlignment="Left">
                        <Button x:Name="BtnGenerateJson" Content="Generar JSON" Width="150" Click="BtnGenerateJson_Click"/>
                        <TextBlock x:Name="StatusTextCs" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Salida JSON -->
                    <GroupBox Header="JSON generado" Grid.Row="3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="4,4,0,0" Foreground="Gray"/>
                                <Button x:Name="BtnCopyJson"
                                        Grid.Column="1"
                                        Content="Copiar JSON"
                                        Width="110"
                                        Height="28"
                                        Click="BtnCopyJson_Click"/>
                            </Grid>

                            <!-- Altura fija -->
                            <TextBox x:Name="JsonOutput"
                                     Grid.Row="1"
                                     Height="260"
                                     AcceptsReturn="True"
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     IsReadOnly="True"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ======================= TAB 3: Arreglar comentarios (C#) ======================= -->
            <TabItem Header="Arreglar comentarios (C#)">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Encabezado: autor y usar IA -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Autor:" VerticalAlignment="Center"/>
                        <TextBox x:Name="FixAuthorNameBox"
                                 Width="200"
                                 Margin="8,0,8,0"
                                 Text="NombreUsuario"
                                 ToolTip="Creador de la clase (para los comentarios generados). Ej.: Ana López"/>

                        <TextBlock Text="ID:" VerticalAlignment="Center"/>
                        <TextBox x:Name="FixAuthorIdBox"
                                 Width="130"
                                 Margin="8,0,16,0"
                                 Text="IDCPM"
                                 ToolTip="Identificador del colaborador (legajo/employee ID). Ej.: BANR25734"/>

                        <CheckBox x:Name="FixUseAi" Content="Generar descripciones con IA (POE)" IsChecked="True"/>
                        <TextBlock x:Name="SelectedFixLabel" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>

                    <!-- Entrada C# -->
                    <GroupBox Header="Código C# (entrada)" Grid.Row="1" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,6">
                                <Button x:Name="BtnImportFix" Content="Importar .cs…" Width="150" Margin="0,0,8,0" Click="BtnImportFix_Click"/>
                                <Button x:Name="BtnClearFix" Content="Limpiar" Width="110" Click="BtnClearFix_Click"/>
                            </StackPanel>

                            <TextBox x:Name="FixInput"
                                     Grid.Row="1"
                                     Height="260"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     ToolTip="Pega aquí el código C# a corregir. Se generarán comentarios XML y se podrán usar descripciones con IA."/>
                        </Grid>
                    </GroupBox>

                    <!-- Botón procesar -->
                    <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,8" HorizontalAlignment="Left">
                        <Button x:Name="BtnFixComments" Content="Arreglar comentarios" Width="170" Click="BtnFixComments_Click"/>
                        <TextBlock x:Name="FixStatusText" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Salida C# corregido -->
                    <GroupBox Header="Código C# corregido" Grid.Row="3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="4,4,0,0" Foreground="Gray"/>
                                <Button x:Name="BtnCopyFix"
                                        Grid.Column="1"
                                        Content="Copiar"
                                        Width="110"
                                        Height="28"
                                        Click="BtnCopyFix_Click"/>
                            </Grid>

                            <TextBox x:Name="FixOutput"
                                     Grid.Row="1"
                                     Height="260"
                                     AcceptsReturn="True"
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     IsReadOnly="True"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ======================= TAB 4: Configuración ======================= -->
            <TabItem Header="Configuración">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Vertical" Margin="0,0,0,8">
                        <TextBlock Text="Configuración de IA (POE)"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="API Key de POE:"
                                   Margin="0,0,0,2"/>

                        <PasswordBox x:Name="PoeApiKeyBox"
                                     Width="420"
                                     Margin="0,0,0,4"
                                     ToolTip="Pega aquí tu API Key personal de POE. Se guardará solo en tu usuario (AppData)."/>

                        <TextBlock x:Name="PoeConfigStatus"
                                   Margin="0,2,0,8"
                                   Foreground="Gray"/>

                        <Button x:Name="BtnSavePoeConfig"
                                Content="Guardar configuración"
                                Width="180"
                                Height="30"
                                Click="BtnSavePoeConfig_Click"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="La API key se guarda de forma local por usuario, en AppData. Si dejas este campo vacío, la aplicación no usará Poe y se intentará usar la solución local configurada en appsettings.json."
                               TextWrapping="Wrap"
                               Foreground="Gray"/>
                </Grid>
            </TabItem>
            <!-- ======================= TAB: Glosario ======================= -->
            <TabItem Header="Glosario">
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical">

                        <!-- ======= CLASES ======= -->
                        <TextBlock Text="Glosario de descripciones de clases"
                       FontWeight="Bold"
                       FontSize="14"
                       Margin="0,0,0,8"/>

                        <DataGrid x:Name="ClassGlossaryGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="False"
                      Margin="0,0,0,4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nombre de clase"
                                        Binding="{Binding ClassName}"
                                        Width="*"/>
                                <DataGridTextColumn Header="Descripción"
                                        Binding="{Binding Description}"
                                        Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,12">
                            <Button x:Name="BtnClassGlossaryAddRow"
                        Content="Agregar fila"
                        Width="110"
                        Margin="0,0,8,0"
                        Click="BtnClassGlossaryAddRow_Click"/>
                            <Button x:Name="BtnClassGlossaryRemoveRow"
                        Content="Eliminar fila seleccionada"
                        Width="170"
                        Margin="0,0,8,0"
                        Click="BtnClassGlossaryRemoveRow_Click"/>
                            <Button x:Name="BtnClassGlossaryReload"
                        Content="Recargar"
                        Width="110"
                        Margin="0,0,8,0"
                        Click="BtnClassGlossaryReload_Click"/>
                            <Button x:Name="BtnClassGlossarySave"
                        Content="Guardar cambios"
                        Width="140"
                        Click="BtnClassGlossarySave_Click"/>

                            <TextBlock x:Name="ClassGlossaryStatusText"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="Gray"/>
                        </StackPanel>

                        <Separator Margin="0,0,0,8"/>

                        <!-- ======= PROPIEDADES GENÉRICAS ======= -->
                        <TextBlock Text="Glosario de descripciones genéricas de propiedades"
                       FontWeight="Bold"
                       FontSize="14"
                       Margin="0,0,0,8"/>

                        <DataGrid x:Name="GenericGlossaryGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="False"
                      Margin="0,0,0,4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nombre de propiedad"
                                        Binding="{Binding PropertyName}"
                                        Width="*"/>
                                <DataGridTextColumn Header="Descripción"
                                        Binding="{Binding Description}"
                                        Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,0">
                            <Button x:Name="BtnGlossaryAddRow"
                        Content="Agregar fila"
                        Width="110"
                        Margin="0,0,8,0"
                        Click="BtnGlossaryAddRow_Click"/>
                            <Button x:Name="BtnGlossaryRemoveRow"
                        Content="Eliminar fila seleccionada"
                        Width="170"
                        Margin="0,0,8,0"
                        Click="BtnGlossaryRemoveRow_Click"/>
                            <Button x:Name="BtnGlossaryReload"
                        Content="Recargar"
                        Width="110"
                        Margin="0,0,8,0"
                        Click="BtnGlossaryReload_Click"/>
                            <Button x:Name="BtnGlossarySave"
                        Content="Guardar cambios"
                        Width="140"
                        Click="BtnGlossarySave_Click"/>

                            <TextBlock x:Name="GlossaryStatusText"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="Gray"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Left"
            Margin="0,12,0,0">
                            <Button x:Name="BtnOpenGlossaryFolder"
            Content="Abrir carpeta del glosario"
            Width="180"
            Margin="0,0,8,0"
            Click="BtnOpenGlossaryFolder_Click"/>
                            <Button x:Name="BtnOpenGlossaryFile"
            Content="Abrir archivo glossary.json"
            Width="180"
            Click="BtnOpenGlossaryFile_Click"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================= TAB: Generar JSON (campos string) ======================= -->
            <TabItem Header="JSON String Fields">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Ingresa listado de campos (uno por línea):"
                   FontSize="14"
                   FontWeight="Bold"/>

                    <!-- Entrada -->
                    <TextBox x:Name="TxtStringFieldsInput"
                 Grid.Row="1"
                 Margin="0,5,10,0"
                 VerticalScrollBarVisibility="Auto"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"/>

                    <!-- Panel derecho -->
                    <StackPanel Grid.Column="1"
                    Grid.Row="1"
                    VerticalAlignment="Top">

                        <Button Content="Generar JSON"
                    x:Name="BtnGenerateStringJson"
                    Width="150"
                    Margin="0,0,0,10"
                    Click="BtnGenerateStringJson_Click"/>

                        <TextBlock Text="Resultado:"
           FontSize="14"
           FontWeight="Bold"
           Margin="0,10,0,5"/>

                        <Button Content="Copiar resultado"
        Width="150"
        Margin="0,0,0,10"
        Click="BtnCopyStringJson_Click"/>

                        <TextBox x:Name="TxtStringFieldsOutput"
         AcceptsReturn="True"
         TextWrapping="Wrap"
         VerticalScrollBarVisibility="Auto"
         Height="300"/>

                    </StackPanel>
                </Grid>
            </TabItem>


        </TabControl>

        <!-- Overlay de “Procesando…” reutilizable (cuadro pequeño centrado) -->
        <Grid x:Name="BusyOverlay"
              Visibility="Collapsed"
              Background="#66000000">
            <Border Width="260"
                    Padding="18"
                    CornerRadius="10"
                    Background="White"
                    Opacity="0.96"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="BusyText" Text="Procesando…" FontSize="14" Margin="0,0,0,12" HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Height="10" Width="180"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
